{
	"extends": "$app/tsconfig",
	"compilerOptions": {
		"strict": true,
		"moduleResolution": "bundler",
		"rootDirs": [".", "./.svelte-kit/types"],
		"paths": {
			"#lib": ["./src/lib/index.ts"],
			"#lib/*": ["./src/lib/*"]
		}
	},
	"include": [
		".svelte-kit/types/**/*.d.ts",
		"src/**/*.d.ts",
		"src/**/*.ts",
		"src/**/*.svelte",
		"vite.config.ts"
	]
}
